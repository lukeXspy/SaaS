# Banco — Supabase (painel > Project Settings > Database)
# Pooler (porta 6543), usada pela aplicação
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432), usada por migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Supabase Storage (painel > Project Settings > API)
# Bucket privado "manutenza-media" — crie via SQL no painel do Supabase:
#   INSERT INTO storage.buckets (id, name, public)
#   VALUES ('manutenza-media', 'manutenza-media', false)
#   ON CONFLICT (id) DO NOTHING;
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="manutenza-media"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Opcional (fase 8+)
# RESEND_API_KEY=""
# SENTRY_DSN=""
